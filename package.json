{
  "name": "cortico-world-astrbot",
  "version": "1.3.2",
  "type": "module",
  "description": "Cortico World: join QQ conversations through an AstrBot bridge, so the bot keeps AstrBot's plugins while a Cortico persona drives the talking",
  "license": "MIT",
  "author": "as124da1231",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/as124da1231/cortico-world-astrbot.git"
  },
  "homepage": "https://github.com/as124da1231/cortico-world-astrbot#readme",
  "bugs": {
    "url": "https://github.com/as124da1231/cortico-world-astrbot/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "astrbot",
    "qq",
    "bridge"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "AstrBot · QQ",
    "icon": "assets/icon.png",
    "tags": [
      "apps",
      "external-setup",
      "unofficial-api"
    ],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cortico": "^0.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
