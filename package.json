{
  "name": "cortico-world-astrbot",
  "version": "1.3.9",
  "type": "module",
  "description": "通过 AstrBot 把 QQ 群聊和私聊接到 Coo，支持引用、合并转发、图片、语音和经授权的 AstrBot 工具。交流 QQ 群 1136066256。",
  "license": "MIT",
  "author": "as124da1231",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/as124da1231/cortico-world-astrbot.git"
  },
  "homepage": "https://github.com/as124da1231/cortico-world-astrbot#readme",
  "bugs": {
    "url": "https://github.com/as124da1231/cortico-world-astrbot/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "astrbot",
    "qq",
    "bridge"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "AstrBot · QQ",
    "icon": "assets/icon.png",
    "tags": [
      "im",
      "qq",
      "voice",
      "external-setup",
      "unofficial-api",
      "unsafe",
      "injection-risk"
    ],
    "locales": {
      "zh": {
        "displayName": "AstrBot · QQ",
        "description": "让 Coo 接入 AstrBot 上的 QQ 群聊和私聊。AstrBot 管理账号、接管范围和插件，Coo 使用当前模型回复。支持引用、合并转发、图片、按需读取 QQ 语音原文件及语音回复。\n\n完整模式使用 Coo 主对话，QQ 回复可能引用控制台里的内容。安全模式隔离 QQ 会话，需要宿主提供独立轮次接口。\n\n请在 AstrBot 4.29.1 或更新版本安装同版本的配套桥插件。主人权限调用工具需要另行授权。交流 QQ 群 1136066256。"
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui-09517eced7cc.js",
    "webUiStyle": "dist/webui-3ca350a42266.css"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "prepack": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cortico": "^0.2.7",
    "esbuild": "0.21.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
