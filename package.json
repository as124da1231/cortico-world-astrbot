{
  "name": "cortico-world-astrbot",
  "version": "1.3.11",
  "type": "module",
  "description": "通过 AstrBot 把 QQ 和 Discord 接到 Coo。QQ 支持引用、合并转发、图片、语音和经授权的 AstrBot 工具。交流 QQ 群 1136066256。",
  "license": "MIT",
  "author": "as124da1231",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/as124da1231/cortico-world-astrbot.git"
  },
  "homepage": "https://github.com/as124da1231/cortico-world-astrbot#readme",
  "bugs": {
    "url": "https://github.com/as124da1231/cortico-world-astrbot/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "astrbot",
    "qq",
    "discord",
    "bridge"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "AstrBot",
    "icon": "assets/icon.png",
    "tags": [
      "im",
      "qq",
      "voice",
      "external-setup",
      "unofficial-api"
    ],
    "locales": {
      "zh": {
        "displayName": "AstrBot",
        "description": "让 QQ 群聊、私聊及已配置的 Discord 频道和主人私聊接入 Coo 主会话，沿用当前人格和模型。支持引用、合并转发、图片、按需读取 QQ 语音原件及语音回复。\n\n安全模式只开放绑定的主人私聊。完整模式可开放指定会话、AstrBot 工具和机器人主动发送，平台回复可能提到 Coo 桌面对话。\n\n跨平台接入需两端都支持 Discord。QQ 仍支持原版 AstrBot 桥插件 1.3.9（AstrBot 4.29.1 或更新版本）。跨机支持 WS 和 WSS，使用一枚桥接令牌。交流 QQ 群 1136066256。"
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui-933bb0f10042.js",
    "webUiStyle": "dist/webui-cbbf5119842f.css"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "prepack": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cortico": "^0.2.7",
    "esbuild": "0.21.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
