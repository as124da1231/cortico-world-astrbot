{
  "name": "cortico-world-astrbot",
  "version": "1.3.7",
  "type": "module",
  "description": "QQ + AstrBot + Coo：不用换 QQ，不用搬 AstrBot 插件，只把说话的人换成 Coo。问题解答 QQ：1136066256。",
  "license": "MIT",
  "author": "as124da1231",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/as124da1231/cortico-world-astrbot.git"
  },
  "homepage": "https://github.com/as124da1231/cortico-world-astrbot#readme",
  "bugs": {
    "url": "https://github.com/as124da1231/cortico-world-astrbot/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "astrbot",
    "qq",
    "bridge"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "AstrBot · QQ",
    "icon": "assets/icon.png",
    "tags": [
      "apps",
      "external-setup",
      "unofficial-api"
    ],
    "locales": {
      "zh": {
        "displayName": "AstrBot · QQ",
        "description": "QQ + AstrBot + Coo：不用换 QQ，不用搬 AstrBot 插件，只把「说话的人」换成 Coo。\n\nQQ 里的人继续在群和私聊里说话；AstrBot 继续管账号、插件、工具和语音；Coo 带着自己的性格和记忆进来回复。\n\n群聊、私聊、@ 或全部消息、图片、语音转写、TTS、撤回和戳一戳都已接上。AstrBot 里装好的工具——点歌、查歌词、天气、直播弹幕——Coo 在 QQ 里直接调用；在 Coo 对话里填好主人 QQ，也能用同一个身份调用。\n\n问题解答 QQ：1136066256。"
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "prepack": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cortico": "^0.2.7",
    "esbuild": "0.21.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
