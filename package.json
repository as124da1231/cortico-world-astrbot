{
  "name": "cortico-world-astrbot",
  "version": "1.3.7",
  "type": "module",
  "description": "通过 AstrBot 把 QQ 群聊和私聊接到 Coo，支持图片、语音和经授权的 AstrBot 工具。交流 QQ 群 1136066256。",
  "license": "MIT",
  "author": "as124da1231",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/as124da1231/cortico-world-astrbot.git"
  },
  "homepage": "https://github.com/as124da1231/cortico-world-astrbot#readme",
  "bugs": {
    "url": "https://github.com/as124da1231/cortico-world-astrbot/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "astrbot",
    "qq",
    "bridge"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "AstrBot · QQ",
    "icon": "assets/icon.png",
    "tags": [
      "apps",
      "external-setup",
      "unofficial-api",
      "unsafe"
    ],
    "locales": {
      "zh": {
        "displayName": "AstrBot · QQ",
        "description": "让 Coo 接入你在 AstrBot 上的 QQ 群聊和私聊。AstrBot 管理账号、接管范围和插件，Coo 沿用自己的对话和记忆给出回复。\n\n支持点名唤醒、图片、语音转写和语音回复。管理员可逐项授权 AstrBot 工具。Coo 本地对话使用主人权限调用工具时，需要单独配置主人 QQ 和工具令牌。\n\n使用前请在 AstrBot 4.29.1 或更新版本安装配套桥插件。交流 QQ 群 1136066256。"
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "prepack": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cortico": "^0.2.7",
    "esbuild": "0.21.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
