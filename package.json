      "external-setup",
      "unofficial-api"
    ],
    "locales": {
      "zh": {
        "displayName": "AstrBot",
        "description": "通过 AstrBot 把 QQ、企业微信、Discord 等接入 Coo 主对话，手机接着电脑聊，权限按机器人实例管理。"
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui-5acf9da42d3f.js",
    "webUiStyle": "dist/webui-7b650de47f39.css",
