{
  "name": "cortico-world-astrbot",
  "version": "1.3.6",
  "type": "module",
  "description": "让 Cortico 的人格 Bot 进 QQ 群和私聊说话，账号、策略、工具和语音留在 AstrBot / Let a Cortico persona talk in QQ groups and private chats while AstrBot keeps the account, policies, tools and voice",
  "license": "MIT",
  "author": "as124da1231",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/as124da1231/cortico-world-astrbot.git"
  },
  "homepage": "https://github.com/as124da1231/cortico-world-astrbot#readme",
  "bugs": {
    "url": "https://github.com/as124da1231/cortico-world-astrbot/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "astrbot",
    "qq",
    "bridge"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "AstrBot · QQ",
    "icon": "assets/icon.png",
    "tags": [
      "apps",
      "external-setup",
      "unofficial-api"
    ],
    "locales": {
      "zh": {
        "displayName": "AstrBot · QQ",
        "description": "让 Cortico 的人格 Bot 进 QQ 群和私聊说话。账号、群/私聊范围、工具和语音仍归 AstrBot；人格、记忆和回复归 Cortico，两边用一条 WebSocket 桥连接。问题解答 QQ：1136066256。"
      },
      "en": {
        "displayName": "AstrBot · QQ",
        "description": "Let a Cortico persona talk in QQ groups and private chats. AstrBot keeps the account, group/private policies, tools and voice; Cortico owns the persona, memory and replies, connected over a WebSocket bridge. Support QQ: 1136066256."
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "README.md",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cortico": "^0.2.7",
    "esbuild": "0.21.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
